{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            cm.id,\n            cm.request_id,\n            cm.sender_id,\n            u.name AS sender_name,\n            cm.message,\n            cm.created_at\n        FROM chat_messages cm\n        INNER JOIN users u\n            ON u.id = cm.sender_id\n        WHERE cm.request_id = $1\n        ORDER BY cm.created_at ASC\n        ",
