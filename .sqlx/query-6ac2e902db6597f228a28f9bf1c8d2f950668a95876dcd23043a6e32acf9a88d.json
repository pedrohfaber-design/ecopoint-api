{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            di.id,\n            di.waste_type_id,\n            wt.name AS waste_type_name,\n            di.quantity\n\n        FROM disposal_items di\n\n        INNER JOIN waste_types wt\n            ON wt.id = di.waste_type_id\n\n        WHERE di.request_id = $1\n\n        ORDER BY wt.name\n        ",
